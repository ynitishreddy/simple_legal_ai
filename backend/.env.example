# ─── Database ────────────────────────────────────────────────────────────────
# For local development SQLite is used automatically (legal_timeline.db).
# Set this to a PostgreSQL DSN for production:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/legal_timeline
DATABASE_URL=sqlite:///./legal_timeline.db

# ─── AWS / S3 ────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET=indian-high-court-judgments
S3_PREFIX=raw/

# ─── Storage & Uploads ───────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ─── App Settings ────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://localhost:8080

# ─── AI / LLM (Optional) ─────────────────────────────────────────────────────
# Provide a Google Gemini API Key for enhanced structured legal event extraction.
# If omitted or left empty, the system automatically falls back to the built-in
# rule-based / regex extraction engine (no GPU or external API required).
GEMINI_API_KEY=
